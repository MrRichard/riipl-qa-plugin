#macro ( newVolumeAnd2DSlice $volumeVar $sliceVar $fileUrl $idBase)
        ${sliceVar} = new X.renderer2D();
        ${sliceVar}.container = '$idBase';
        ${sliceVar}.orientation = 'AXIAL';
        ${sliceVar}.init();

        ${volumeVar} = new X.volume();
        #if ($fn.toLowerCase().contains('_cbf'))
                ${volumeVar}.file = '$fileUrl';
                ${volumeVar}.labelmap.file = '$fileUrl';
                ${volumeVar}.labelmap.colortable.file = '/xnat/misc_ansir/ASL_colormap.txt';
        #elseif ($fn.toLowerCase().contains('_att'))
                ${volumeVar}.file = '$fileUrl';
                ${volumeVar}.labelmap.file = '$fileUrl';
                ${volumeVar}.labelmap.colortable.file = '/xnat/misc_ansir/ATT_colormap.txt';
        #elseif ($fn.toLowerCase().contains('_lesion_'))
                ${volumeVar}.file = '$flair';
                ${volumeVar}.labelmap.file = '$fileUrl';
                ${volumeVar}.labelmap.colortable.file = '/xnat/misc_ansir/LST8_colormap.txt';
        #else
                ${volumeVar}.file = '$fileUrl';
        #end

        ${sliceVar}.add(${volumeVar});
        ${sliceVar}.render();
#end

