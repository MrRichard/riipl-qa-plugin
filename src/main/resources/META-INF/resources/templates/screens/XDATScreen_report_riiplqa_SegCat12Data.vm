#macro ( includeXtk )
	<script type="text/javascript" LANGUAGE="JavaScript" src="$content.getURI('scripts/xtk.js')"> </script>
	<script type="text/javascript">
		function addLoadEvent(func) {
				var oldonload = window.onload;
				if (typeof window.onload != 'function') {
					window.onload = func;
				} else {
					window.onload = function() {
						if (oldonload) {
							oldonload();
						}
						func();
					}
				}
			}
		</script>
#end

#macro ( newVolumeAnd2DSlice $volumeVar $sliceVar $fileUrl $idBase)
	${sliceVar} = new X.renderer2D();
	${sliceVar}.container = '$idBase';
	${sliceVar}.orientation = 'Z';
	${sliceVar}.init();

	${volumeVar} = new X.volume();
	#if ($fn.toLowerCase().contains('_cbf'))
		${volumeVar}.file = '$fileUrl';
		${volumeVar}.labelmap.file = '$fileUrl';
		#${volumeVar}.labelmap.colortable.file = '/style/ASL_colormap.txt';
	#elseif ($fn.toLowerCase().contains('_att'))
		${volumeVar}.file = '$fileUrl';
		${volumeVar}.labelmap.file = '$fileUrl';
		#${volumeVar}.labelmap.colortable.file = '/style/ATT_colormap.txt';
	#elseif ($fn.toLowerCase().contains('_lesion_'))
		${volumeVar}.file = '$flair';
		${volumeVar}.labelmap.file = '$fileUrl';
		#${volumeVar}.labelmap.colortable.file = '/style/LST8_colormap.txt';
	#else
		${volumeVar}.file = '$fileUrl';
	#end

	${sliceVar}.add(${volumeVar});
	${sliceVar}.render();
#end

