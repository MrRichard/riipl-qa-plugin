#macro( highlightGreaterThanLessThanCell $name $item $default $vr $valueHi $valueLo $color $cellStyle)
	#set ( $threshHi = $mathTool.toDouble($valueHi) )
	#set ( $threshLo = $mathTool.toDouble($valueLo) )
	#set ( $v      = $mathTool.toDouble($!item.getProperty($name)) )
	#if ( $mathTool.min($threshLo,$v) == $mathTool.min($threshLo,$threshLo))
		#if ( $mathTool.max($threshHi,$v) == $mathTool.max($threshHi,$threshHi))
			<TD ${cellStyle}>#riiplShowString($name $item $default $vr)</TD>
		#else
			<TD ${cellStyle} bgcolor="${color}" >Hi: #riiplShowString($name $item $default $vr) &gt; $threshHi</TD>
		#end
	#else
