<script type="text/javascript">
function validateForm()
{
	//INSERT CUSTOM CONTENT HERE
	try
	{
		validateExperimentForm();
	}
	catch (err)
	{
		try {alert("error name: " + err.name); } catch (err2) {}
		try {alert("error message: " + err.message); } catch (err2) {}
		try {alert("error file: " + err.fileName); } catch (err2) {}
		try {alert("error lineNumber: " + err.lineNumber); } catch (err2) {}
		try {alert("error extMessage: " + err.extMessage); } catch (err2) {}
	}
	return false;
}
</script>

