#macro (riiplShowDate $name $item $vr $years)
	$turbineUtils.formatDate($item.getProperty($name),'EEE MMM dd, yyyy')
	<input id="$name" type="hidden" name="$name" value="$turbineUtils.formatDate($item.getProperty($name),'yyyy-MM-dd')" />
#end

#macro (riiplSimpleSelectBoxLbl $lbl $name $item $possibleValues $vr)
	#if ($vr)
		#if($vr.getField($name))
			<span style="color:red;">&#8658</span>
		#end
	#end
	
	#if($item.isPKField($name)&& (!$vr.getField($name)))
		<input ID="$name" type="hidden" name="$name" value="$item.getProperty($name)"/>
		$item.getProperty($name)
	#else
		#if ($possibleValues.size()==0)
			<input ID="$name" type="text" name="$name" value="$item.getProperty($name)"/>
		#else
			<SELECT ID="$name" name="$name">
			<OPTION VALUE="">$!lbl</OPTION>
			#foreach ($pValue in $possibleValues)
				<OPTION VALUE="$pValue" #if($pValue.equals($item.getProperty($name))) SELECTED #end>$pValue</OPTION>
			#end
			</SELECT>
		#end
	#end
#end

#macro (riiplSimpleSelectBox $name $item $possibleValues $vr)
	#riiplSimpleSelectBoxLbl("(SELECT)" $name $item $possibleValues $vr)
#end

#if ($data.message)
	<font color="red" size="3">$data.message</font>
#end

